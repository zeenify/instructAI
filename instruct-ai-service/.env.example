# Google AI Studio (Gemini) — used for all generation via the OpenAI-compatible endpoint.
# Optional extras: GEMINI_API_KEY2..4 join the round-robin pool automatically.
GEMINI_API_KEY=your_gemini_api_key_here

# Pexels API (Required for real images)
PEXELS_API_KEY=your_pexels_api_key_here

# YouTube Data API (Required for real videos)
YOUTUBE_API_KEY=your_youtube_api_key_here

# instruct-execute engine — verifies AI-generated test cases and challenge outputs
EXECUTION_ENGINE_URL=http://localhost:3000
